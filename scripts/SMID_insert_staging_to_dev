WITH src AS (
    SELECT *
    FROM public.smid_staging
),
skipped AS (
    SELECT
        s.smid,
        s.gcn,
        s.account_id
    FROM src s
    WHERE EXISTS (
        SELECT 1
        FROM public.smid t
        WHERE t.smid = s.smid
    )
),
ins AS (
    INSERT INTO public.smid (
        title,
        smid,
        account_id,
        gcn,
        account_status,
        country,
        country_a2,
        country_region,
        country_ops_region_i,
        country_sanctioned,
        status,
        de_implement_all,
        gds_profile_name,
        tspm_number,
        platform_id,
        sql_id,
        einvoice_portal,
        travel_authorization_tool,
        obt,
        obt_offline_approval_required,
        traveler_country,
        ticketing_country,
        servicing_country,
        invoicing_country,
        cliq_id,
        cliqservice_id,
        country_id,
        snap_pof_code,
        service_until_date,
        last_date_of_service_new_bookings,
        last_date_of_service_booking_changes,
        go_live_date,
        customer_entity_id,
        iata,
        branch_number,
        point_of_sale_tool,
        ndc,
        trip_authorizer,
        apa,
        hpa,
        obt_asb_integratoin,
        region_of_service,
        country_of_service,
        bcd_team,
        time_zone,
        ess_setup,
        daytime_ops_hours,
        gds,
        mon_doh,
        tue_doh,
        wed_doh,
        thur_doh,
        fri_doh,
        sat_doh,
        sun_doh,
        l1_profile,
        l2_profile,
        concur_approval,
        hr_feed,
        hr_frequency,
        e_invoice_portal,
        e_invoice_portal_location,
        back_office_1,
        trav_profile_format,
        account_type,
        dk_number
    )
    SELECT
        title,
        smid,
        account_id,
        gcn::text,
        account_status,
        country,
        country_a2,
        country_region::text,
        country_ops_region_i,
        country_sanctioned,
        status,
        de_implement_all,
        gds_profile_name,
        tspm_number,
        platform_id,
        sql_id,
        einvoice_portal,
        travel_authorization_tool,
        obt,
        obt_offline_approval_required,
        traveler_country,
        ticketing_country,
        servicing_country,
        invoicing_country,
        cliq_id,
        cliqservice_id,
        country_id,
        snap_pof_code,
        service_until_date,
        last_date_of_service_new_bookings,
        last_date_of_service_booking_changes,
        go_live_date,
        customer_entity_id,
        iata,
        branch_number::int4,
        point_of_sale_tool,
        ndc,
        trip_authorizer,
        apa,
        hpa,
        obt_asb_integratoin,
        region_of_service,
        country_of_service,
        bcd_team,
        time_zone,
        ess_setup,
        daytime_ops_hours,
        gds,
        mon_doh,
        tue_doh,
        wed_doh,
        thur_doh,
        fri_doh,
        sat_doh,
        sun_doh,
        l1_profile,
        l2_profile,
        concur_approval,
        hr_feed,
        hr_frequency,
        e_invoice_portal,
        e_invoice_portal_location,
        back_office_1,
        trav_profile_format,
        account_type,
        dk_number
    FROM src s
    WHERE NOT EXISTS (
        SELECT 1
        FROM public.smid t
        WHERE t.smid = s.smid
    )
    RETURNING smid
)
SELECT
    (SELECT COUNT(*) FROM src) AS staging_rows,
    (SELECT COUNT(*) FROM ins) AS inserted_rows,
    (SELECT COUNT(*) FROM skipped) AS skipped_rows,
    (
        SELECT string_agg(smid::text, ', ' ORDER BY smid)
        FROM skipped
    ) AS skipped_smids;
