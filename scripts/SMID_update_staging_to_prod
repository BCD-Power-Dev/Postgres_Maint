WITH src AS (
    SELECT *
    FROM public.smid_staging
),
skipped AS (
    SELECT
        s.smid,
        s.gcn,
        s.account_id
    FROM src s
    WHERE NOT EXISTS (
        SELECT 1
        FROM public.smid t
        WHERE t.smid = s.smid
    )
),
upd AS (
    UPDATE public.smid AS t
    SET
        title = s.title,
        account_id = s.account_id,
        gcn = s.gcn::text,
        account_status = s.account_status,
        country = s.country,
        country_a2 = s.country_a2,
        country_region = s.country_region::text,
        country_ops_region_i = s.country_ops_region_i,
        country_sanctioned = s.country_sanctioned,
        status = s.status,
        de_implement_all = s.de_implement_all,
        gds_profile_name = s.gds_profile_name,
        tspm_number = s.tspm_number,
        platform_id = s.platform_id,
        sql_id = s.sql_id,
        einvoice_portal = s.einvoice_portal,
        travel_authorization_tool = s.travel_authorization_tool,
        obt = s.obt,
        obt_offline_approval_required = s.obt_offline_approval_required,
        traveler_country = s.traveler_country,
        ticketing_country = s.ticketing_country,
        servicing_country = s.servicing_country,
        invoicing_country = s.invoicing_country,
        cliq_id = s.cliq_id,
        cliqservice_id = s.cliqservice_id,
        country_id = s.country_id,
        snap_pof_code = s.snap_pof_code,
        service_until_date = s.service_until_date,
        last_date_of_service_new_bookings = s.last_date_of_service_new_bookings,
        last_date_of_service_booking_changes = s.last_date_of_service_booking_changes,
        go_live_date = s.go_live_date,
        customer_entity_id = s.customer_entity_id,
        iata = s.iata,
        branch_number = s.branch_number::int4,
        point_of_sale_tool = s.point_of_sale_tool,
        ndc = s.ndc,
        trip_authorizer = s.trip_authorizer,
        apa = s.apa,
        hpa = s.hpa,
        obt_asb_integratoin = s.obt_asb_integratoin,
        region_of_service = s.region_of_service,
        country_of_service = s.country_of_service,
        bcd_team = s.bcd_team,
        time_zone = s.time_zone,
        ess_setup = s.ess_setup,
        daytime_ops_hours = s.daytime_ops_hours,
        gds = s.gds,
        mon_doh = s.mon_doh,
        tue_doh = s.tue_doh,
        wed_doh = s.wed_doh,
        thur_doh = s.thur_doh,
        fri_doh = s.fri_doh,
        sat_doh = s.sat_doh,
        sun_doh = s.sun_doh,
        l1_profile = s.l1_profile,
        l2_profile = s.l2_profile,
        concur_approval = s.concur_approval,
        hr_feed = s.hr_feed,
        hr_frequency = s.hr_frequency,
        e_invoice_portal = s.e_invoice_portal,
        e_invoice_portal_location = s.e_invoice_portal_location,
        back_office_1 = s.back_office_1,
        trav_profile_format = s.trav_profile_format,
        account_type = s.account_type,
        dk_number = s.dk_number
    FROM src s
    WHERE t.smid = s.smid
    RETURNING t.smid
)
SELECT
    (SELECT COUNT(*) FROM src) AS staging_rows,
    (SELECT COUNT(*) FROM upd) AS updated_rows,
    (SELECT COUNT(*) FROM skipped) AS skipped_rows,
    (
        SELECT string_agg(smid::text, ', ' ORDER BY smid)
        FROM skipped
    ) AS skipped_smids;
